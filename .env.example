# @BotFather bergan token
BOT_TOKEN=1234567890:AAH-your-token-here

# Progrev kanali havolasi (oxirgi qadamdagi tugma shu yerga olib boradi)
CHANNEL_URL=https://t.me/your_channel

# Yangi arizalar yuboriladigan chat (guruh yoki shaxsiy). Guruh ID odatda -100 bilan boshlanadi.
# ID ni bilish uchun: botni guruhga qo'shing va guruhda /id yozing.
ADMIN_CHAT_ID=-1001234567890

# /stats va /export buyruqlaridan foydalana oladigan foydalanuvchilar (vergul bilan)
ADMIN_IDS=123456789,987654321

# Arizalar saqlanadigan fayl
DB_PATH=leads.db
